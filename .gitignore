# =========================================
# The Neuro-Genesis Engine: .gitignore
# =========================================

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/

# Secrets & Configuration
.env
*.pem
secrets.json

# PyTorch & Machine Learning Weights
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# Dynamic Logs & Telemetry
logs/
runs/
wandb/
lightning_logs/
*.log

# Data (Raw/Simulated from Featherless)
data/
datasets/
*.csv
*.jsonl

# except: canonical demo log the visualizer fetches at runtime
!orchestrator_run_amd_hardware.jsonl

# OS Generated Files
.DS_Store
Thumbs.db